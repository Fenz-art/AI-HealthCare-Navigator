generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SeverityLevel {
  SELF_CARE
  PHARMACY
  CLINIC
  HOSPITAL
  EMERGENCY
}

enum OtcStatus {
  FULL_OTC
  PHARMACY_ONLY
  PRESCRIPTION_ONLY
}

enum DoseRule {
  STANDARD_OTC
  REDUCED_OTC
  PRESCRIBED
}

enum ProviderType {
  PHARMACY
  CLINIC
  HOSPITAL
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions TravelHealthSession[]
}

model Country {
  id   String @id @default(cuid())
  name String @unique
  code String @unique

  brands          Brand[]
  medicationEdges MedicationEdge[]
  providers       Provider[]
  sessions        TravelHealthSession[]
}

model ActiveIngredient {
  id   String @id @default(cuid())
  name String @unique

  brands          Brand[]
  medicationEdges MedicationEdge[]
}

model Brand {
  id                 String           @id @default(cuid())
  name               String
  countryId          String
  activeIngredientId String
  otcStatus          OtcStatus        @default(FULL_OTC)
  doseRule           DoseRule         @default(STANDARD_OTC)

  country            Country          @relation(fields: [countryId], references: [id])
  activeIngredient   ActiveIngredient @relation(fields: [activeIngredientId], references: [id])
  medicationEdges    MedicationEdge[]

  @@unique([name, countryId])
}

model MedicationEdge {
  id                 String           @id @default(cuid())
  activeIngredientId String
  countryId          String
  brandId            String
  notes              String?

  activeIngredient   ActiveIngredient @relation(fields: [activeIngredientId], references: [id])
  country            Country          @relation(fields: [countryId], references: [id])
  brand              Brand            @relation(fields: [brandId], references: [id])

  @@unique([activeIngredientId, countryId, brandId])
}

model Provider {
  id         String       @id @default(cuid())
  name       String
  type       ProviderType
  address    String
  lat        Float
  lng        Float
  countryId  String
  externalId String?

  country     Country      @relation(fields: [countryId], references: [id])
}

model TravelHealthSession {
  id                String        @id @default(cuid())
  userId            String?
  location          String?
  countryId         String?
  symptoms          String[]
  duration          String?
  allergies         String[]
  currentMeds       String[]
  severity          SeverityLevel?
  medRecs           Json?
  providerRecs      Json?
  interpreterContext String?
  outcome           Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user    User?    @relation(fields: [userId], references: [id])
  country Country? @relation(fields: [countryId], references: [id])
}
