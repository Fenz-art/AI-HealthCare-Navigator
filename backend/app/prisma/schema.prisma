generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model HealthcareJourney {
  id               String        @id @default(cuid())
  userId           String
  sessionId        String?
  country          String
  city             String?
  symptoms         Json
  severity         String
  recommendation   String
  medicationFound  Boolean       @default(false)
  medicationId     String?
  providerVisited  Boolean       @default(false)
  providerId       String?
  interpreterUsed  Boolean       @default(false)
  outcomeStatus    OutcomeStatus
  recoveryTimeDays Int?
  notes            String?
  createdAt        DateTime      @default(now())
  user             User          @relation(fields: [userId], references: [id])
  outcomeInsights OutcomeInsight[]
}


model User {
  id                       String                    @id @default(cuid())
  email                    String                    @unique
  name                     String?
  image                    String?
  homeCountry              String?
  preferredLanguage        String?
  allergies                String?
  medications              String?
  emergencyContacts        String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  dateOfBirth              String?
  onboardingComplete       Boolean                   @default(false)
  role                     UserRole?
  bloodGroup               String?
  accounts                 Account[]
  activityItems            ActivityItem[]
  agentTasks               AgentTask[]
  conversationParticipants ConversationParticipant[]
  healthDocuments          HealthDocument[]
  healthPassport           HealthPassport?
  healthcareJourneys       HealthcareJourney[]
  outcomeInsights          OutcomeInsight[]
  medicalMemories          MedicalMemory[]
  readReceipts             MessageRead[]
  notifications            Notification[]
  providerWorkspace        ProviderWorkspace?
  sessions                 Session[]
  sharedPassports          SharedPassport[]
  travelHealthSessions     TravelHealthSession[]
  presence                 UserPresence?
}


model HealthPassport {
  id                 String           @id @default(cuid())
  userId             String           @unique
  bloodGroup         String?
  allergies          String?
  currentMedications String?
  chronicConditions  String?
  vaccinations       String?
  emergencyContacts  String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               User             @relation(fields: [userId], references: [id])
  sharedPassports    SharedPassport[]
}

model HealthDocument {
  id                String                   @id @default(cuid())
  userId            String
  type              String
  title             String
  sourceCountry     String?
  originalLanguage  String?
  fileUrl           String
  extractedText     String?
  translatedText    String?
  isSharedInSession Boolean                  @default(false)
  uploadedAt        DateTime                 @default(now())
  processingStatus  ProcessingStatus         @default(PENDING)
  storageUrl        String?
  agentTasks        AgentTask[]
  processingJobs    DocumentProcessingJob[]
  extractedEntities ExtractedMedicalEntity[]
  user              User                     @relation(fields: [userId], references: [id])
  extraction        MedicalExtraction?
}

model Country {
  id              String                @id @default(cuid())
  name            String                @unique
  code            String                @unique
  brands          Brand[]
  medicationEdges MedicationEdge[]
  providers       Provider[]
  sessions        TravelHealthSession[]
}

model ActiveIngredient {
  id              String           @id @default(cuid())
  name            String           @unique
  brands          Brand[]
  medicationEdges MedicationEdge[]
}

model Brand {
  id                 String           @id @default(cuid())
  name               String
  countryId          String
  activeIngredientId String
  otcStatus          String           @default("FULL_OTC")
  doseRule           String           @default("STANDARD_OTC")
  activeIngredient   ActiveIngredient @relation(fields: [activeIngredientId], references: [id])
  country            Country          @relation(fields: [countryId], references: [id])
  medicationEdges    MedicationEdge[]

  @@unique([name, countryId])
}

model MedicationEdge {
  id                 String           @id @default(cuid())
  activeIngredientId String
  countryId          String
  brandId            String
  notes              String?
  activeIngredient   ActiveIngredient @relation(fields: [activeIngredientId], references: [id])
  brand              Brand            @relation(fields: [brandId], references: [id])
  country            Country          @relation(fields: [countryId], references: [id])

  @@unique([activeIngredientId, countryId, brandId])
}

model Provider {
  id         String  @id @default(cuid())
  name       String
  type       String
  address    String
  lat        Float
  lng        Float
  countryId  String
  externalId String?
  country    Country @relation(fields: [countryId], references: [id])
}

model TravelHealthSession {
  id                           String             @id @default(cuid())
  caseId                       String             @unique
  userId                       String?
  location                     String?
  countryId                    String?
  lat                          Float?
  lng                          Float?
  symptoms                     String
  duration                     String?
  allergies                    String
  currentMeds                  String
  severity                     String?
  medRecs                      String?
  providerRecs                 String?
  interpreterContext           String?
  interpreterContextTranslated String?
  includedPassport             Boolean            @default(false)
  includedDocuments            String?
  outcome                      String?
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt
  assistanceRequest            AssistanceRequest?
  messages                     Message[]
  country                      Country?           @relation(fields: [countryId], references: [id])
  user                         User?              @relation(fields: [userId], references: [id])
}

model AssistanceRequest {
  id         String              @id @default(cuid())
  sessionId  String              @unique
  status     String              @default("PENDING")
  assignedTo String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  session    TravelHealthSession @relation(fields: [sessionId], references: [id])
  messages   Message[]
}

model Message {
  id                  String               @id @default(cuid())
  sessionId           String?
  senderId            String?
  senderType          String
  content             String
  createdAt           DateTime             @default(now())
  assistanceRequestId String?
  conversationId      String?
  status              String               @default("SENT")
  attachments         Attachment[]
  AssistanceRequest   AssistanceRequest?   @relation(fields: [assistanceRequestId], references: [id])
  conversation        Conversation?        @relation(fields: [conversationId], references: [id])
  session             TravelHealthSession? @relation(fields: [sessionId], references: [id])
  readReceipts        MessageRead[]
}

model Conversation {
  id              String                    @id @default(cuid())
  title           String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  events          ConversationEvent[]
  participants    ConversationParticipant[]
  messages        Message[]
  sharedPassports SharedPassport[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  role           String?
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Attachment {
  id        String   @id @default(cuid())
  messageId String
  type      String
  name      String
  url       String
  size      Int?
  mimeType  String?
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model SharedPassport {
  id             String         @id @default(cuid())
  passportId     String
  conversationId String?
  shareToken     String         @unique
  qrCodeUrl      String?
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())
  accessCount    Int            @default(0)
  createdBy      String
  lastViewedAt   DateTime?
  revoked        Boolean        @default(false)
  shareType      String         @default("QUICK")
  conversation   Conversation?  @relation(fields: [conversationId], references: [id])
  creator        User           @relation(fields: [createdBy], references: [id])
  passport       HealthPassport @relation(fields: [passportId], references: [id])

  @@index([createdBy])
  @@index([passportId])
}

model AgentTask {
  id          String          @id @default(cuid())
  userId      String
  type        TaskType
  status      TaskStatus      @default(PENDING)
  progress    Int             @default(0)
  title       String
  description String?
  input       String?
  output      String?
  error       String?
  documentId  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  document    HealthDocument? @relation(fields: [documentId], references: [id])
  user        User            @relation(fields: [userId], references: [id])
}

model MedicalExtraction {
  id            String         @id @default(cuid())
  documentId    String         @unique
  conditions    String?
  medications   String?
  allergies     String?
  procedures    String?
  insuranceMeta String?
  vitalSigns    String?
  labResults    String?
  extractedAt   DateTime       @default(now())
  document      HealthDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model DocumentProcessingJob {
  id          String         @id @default(cuid())
  documentId  String
  status      JobStatus      @default(PENDING)
  currentStep String         @default("STORING")
  progress    Int            @default(0)
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  document    HealthDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model ExtractedMedicalEntity {
  id          String            @id @default(cuid())
  userId      String
  entityType  MedicalEntityType
  value       String
  confidence  Float             @default(0.0)
  sourceDocId String?
  language    String?
  document    HealthDocument?   @relation(fields: [sourceDocId], references: [id])

  @@index([userId])
  @@index([userId, entityType])
}

model MedicalMemory {
  id               String     @id @default(cuid())
  userId           String
  memoryType       MemoryType
  value            String
  source           String     @default("manual")

  // Provenance (Sprint 7.5) — additive, nullable/defaulted to preserve legacy rows
  sourceType       String   @default("UNKNOWN")
  sourceSessionId  String?
  sourceDocumentId String?
  confidence       Float?

  // Verification
  verified   Boolean    @default(false)
  verifiedAt DateTime?
  verifiedBy String?

  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, memoryType])
  @@index([sourceSessionId])
  @@index([sourceDocumentId])
}


model UserPresence {
  userId      String         @id
  status      PresenceStatus @default(OFFLINE)
  lastSeenAt  DateTime       @default(now())
  currentPage String?
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

model ConversationEvent {
  id             String       @id @default(cuid())
  conversationId String
  eventType      EventType
  title          String
  description    String?
  metadata       String?
  actorId        String?
  actorName      String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  data      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

model ActivityItem {
  id          String    @id @default(cuid())
  userId      String
  eventType   EventType
  title       String
  description String?
  metadata    String?
  linkUrl     String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model InterpreterSession {
  id              String    @id @default(cuid())
  patientId       String
  providerId      String?
  sessionId       String?
  conversationId  String?
  sourceLanguage  String
  targetLanguage  String
  active          Boolean   @default(true)
  transcript      Json      @default("[]")
  durationSeconds Int?
  mode            String    @default("bidirectional")
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
}

model AccessLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  ipHash       String?
  userAgent    String?
  metadata     String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

model MemoryCandidate {
  id         String          @id @default(cuid())
  userId     String
  sessionId  String?
  memoryType MemoryType
  value      String
  source     String          @default("interpreter-extraction")
  confidence Float           @default(0.0)
  context    String?
  status     CandidateStatus @default(PENDING_REVIEW)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([userId, status])
  @@index([status])
}

model DataSource {
  id         String         @id @default(cuid())
  name       String
  country    String?
  sourceType String
  lastSyncAt DateTime?
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now())
  jobs       IngestionJob[]
}

model IngestionJob {
  id              String             @id @default(cuid())
  dataSourceId    String
  sourceType      DataSourceType
  status          IngestionJobStatus @default(QUEUED)
  progress        Int                @default(0)
  recordsImported Int                @default(0)
  recordsFailed   Int                @default(0)
  error           String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime           @default(now())
  dataSource      DataSource         @relation(fields: [dataSourceId], references: [id])

  @@index([dataSourceId])
  @@index([status])
}

model MedicationReference {
  id           String   @id @default(cuid())
  sourceId     String
  sourceType   String
  country      String
  brandName    String
  ingredient   String
  strength     String?
  otc          Boolean?
  route        String?
  manufacturer String?
  meta         String?
  importedAt   DateTime @default(now())

  @@unique([sourceId, sourceType])
  @@index([ingredient])
  @@index([country, brandName])
  @@index([country, ingredient])
}

model OutcomeInsight {
  id            String      @id @default(cuid())
  userId        String
  journeyId     String
  insightType   InsightType
  country       String?
  city          String?
  condition     String?
  medication    String?
  outcomeStatus OutcomeStatus
  recoveryDays  Int?
  confidence    Float?
  summary       String?
  generatedAt   DateTime @default(now())

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  journey HealthcareJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([journeyId])
  @@index([insightType])
  @@index([country])
  @@index([outcomeStatus])

  // Idempotency: each journey produces exactly one row per insightType
  @@unique([journeyId, insightType])
}



model MedicationOutcome {
  id            String   @id @default(cuid())
  medicationId  String
  country       String
  condition     String?
  outcomeStatus OutcomeStatus
  recoveryDays  Int?
  createdAt     DateTime @default(now())

  @@index([medicationId])
  @@index([country])
  @@index([condition])
  @@index([outcomeStatus])
}

model ProviderOutcome {
  id                  String   @id @default(cuid())
  providerId           String   @unique
  journeys             Int      @default(0)
  interpreterUsageRate Float
  avgRecoveryDays      Float?
  updatedAt            DateTime @updatedAt

  @@index([providerId])
}


model ProviderReference {
  id           String   @id @default(cuid())
  sourceId     String
  sourceType   String
  country      String
  city         String?
  providerType String
  name         String?
  address      String?
  lat          Float?
  lng          Float?
  languages    Json?
  phone        String?
  meta         String?
  importedAt   DateTime @default(now())

  @@index([country, city])
  @@index([providerType])
}

model ProviderWorkspace {
  id            String         @id @default(cuid())
  userId        String         @unique
  role          String
  specialties   String?
  languages     String?
  organization  String?
  availability  String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id])
  verifications Verification[]

  @@index([userId])
  @@index([role])
}

model Verification {
  id           String             @id @default(cuid())
  providerId   String
  type         VerificationType
  status       VerificationStatus @default(PENDING)
  documentUrl  String?
  documentName String?
  verifiedBy   String?
  verifiedAt   DateTime?
  notes        String?
  expiresAt    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  provider     ProviderWorkspace  @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@index([status])
}

enum UserRole {
  PATIENT
  MEDICAL_ASSISTANT
  PHARMACIST
  DOCTOR
  CLINIC_STAFF
  HOSPITAL_STAFF
}

enum TaskStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum OutcomeStatus {
  RECOVERED
  IMPROVED
  UNCHANGED
  WORSENED
}

enum InsightType {
  RECOVERY_TREND
  MEDICATION_EFFECTIVENESS
  COUNTRY_PATTERN
  INTERPRETER_USAGE
  PROVIDER_PATTERN
}


enum ProcessingStatus {
  PENDING
  STORING
  OCR
  DETECTING_LANGUAGE
  TRANSLATING
  EXTRACTING
  UPDATING_MEMORY
  UPDATING_PASSPORT
  COMPLETED
  FAILED
}

enum MedicalEntityType {
  CONDITION
  MEDICATION
  ALLERGY
  PROCEDURE
  VACCINATION
  INSURANCE
  EMERGENCY_CONTACT
}

enum MemoryType {
  CONDITION
  MEDICATION
  ALLERGY
  PROCEDURE
  VACCINATION
  INSURANCE
  EMERGENCY_CONTACT
  LAB_RESULT
  VITAL_SIGN
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum TaskType {
  TRANSLATE_DOCUMENT
  EXTRACT_MEDICAL_DATA
  UPDATE_PASSPORT
  GENERATE_SUMMARY
  PROCESS_UPLOAD
  SHARE_PASSPORT
  EXTRACT_CONDITIONS
  EXTRACT_MEDICATIONS
  GENERATE_PROVIDER_SUMMARY
  GENERATE_PHARMACIST_SUMMARY
  GENERATE_DOCTOR_SUMMARY
  GENERATE_TRAVEL_PACKAGE
  GENERATE_CLINICAL_SUMMARY
  GENERATE_MEDICATION_TIMELINE
  GENERATE_CONDITION_TIMELINE
  GENERATE_VACCINATION_HISTORY
  TRANSLATE_PRESCRIPTION
  FIND_MEDICATION_EQUIVALENTS
  GENERATE_MEDICATION_SUMMARY
  TRANSLATE_DOCUMENTS
  PREPARE_PASSPORT_PACKAGE
  PREPARE_INSURANCE_SUMMARY
  PREPARE_VISIT_SUMMARY
}

enum PresenceStatus {
  ONLINE
  AWAY
  OFFLINE
}

enum EventType {
  PASSPORT_SHARED
  MEDICAL_RECORD_UPLOADED
  TRANSLATION_GENERATED
  INTERPRETER_STARTED
  INTERPRETER_ENDED
  PROVIDER_SUMMARY_SHARED
  DOCUMENT_PROCESSED
  AGENT_TASK_COMPLETED
  JOURNEY_COMPLETED
  PROVIDER_VIEWED_PASSPORT
  MESSAGE_SENT
  TRANSCRIPT_AVAILABLE
  PATIENT_JOINED
  ASSISTANT_JOINED
  PHARMACIST_JOINED
  DOCTOR_JOINED
  PASSPORT_VIEWED
  SUMMARY_GENERATED
  TRANSLATION_REQUESTED
  INTERPRETER_SESSION_STARTED
  CONVERSATION_ASSIGNED
  RECORD_VIEWED
  FILE_DOWNLOADED
  CONSENT_GRANTED
  CONSENT_REVOKED
  RECORD_SHARED
  MEMORY_CANDIDATE_APPROVED
  MEMORY_CANDIDATE_REJECTED
  SHARE_ACCESSED
  SHARE_REVOKED
}

enum NotificationType {
  PASSPORT_VIEWED
  DOCUMENT_PROCESSED
  TRANSLATION_READY
  MESSAGE_RECEIVED
  AGENT_TASK_COMPLETE
  PROVIDER_RESPONSE
  INTERPRETER_READY
  SHARE_ACCESSED
}

enum CandidateStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum IngestionJobStatus {
  QUEUED
  RUNNING
  FAILED
  COMPLETED
}

enum DataSourceType {
  OPENFDA
  DAILYMED
  EMA
  NHS
}

enum VerificationStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum VerificationType {
  LICENSE
  PHARMACY
  ORGANIZATION
}
